<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Mesaj de pe site</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #ece4d4;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .container {
        background-color: #fff;
        border-radius: 8px;
        padding: 24px;
        margin-top: 20px;
      }
      h1 {
        color: #546a50;
        margin-top: 0;
      }
      .label {
        font-weight: bold;
        color: #546a50;
        margin-top: 16px;
      }
      .value {
        margin: 4px 0 0;
        white-space: pre-wrap;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1><%= subject %></h1>
      <p class="label">Nume</p>
      <p class="value"><%= name %></p>
      <p class="label">Email</p>
      <p class="value"><%= email %></p>
      <% if (phone) { %>
      <p class="label">Telefon</p>
      <p class="value"><%= phone %></p>
      <% } %>
      <p class="label">Mesaj</p>
      <p class="value"><%= message %></p>
    </div>
  </body>
</html>
