<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Loc confirmat</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #ece4d4;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .container {
        background-color: #fff;
        border-radius: 8px;
        padding: 24px;
        margin-top: 20px;
      }
      h1 {
        color: #546a50;
        margin-top: 0;
      }
      .detail {
        margin: 4px 0;
      }
      .footer {
        margin-top: 24px;
        font-size: 12px;
        color: #666;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Locul tău este confirmat</h1>
      <p>Bună, <%= firstName %>,</p>
      <p>
        Rezervarea <strong><%= code %></strong> pentru atelierul
        <strong><%= title %></strong> este confirmată.
      </p>
      <p class="detail"><strong>Data și ora:</strong> <%= when %></p>
      <p class="detail"><strong>Adresa:</strong> <%= location %></p>
      <p class="detail">
        <strong>Locuri:</strong> <%= spots %>
      </p>
      <% if (invoiceAttached) { %>
        <p>Factura pentru plata cu cardul este atașată acestui email.</p>
      <% } else if (!paidByCard) { %>
        <p>Plata se face numerar, la atelier.</p>
      <% } %>
      <p class="footer">Mâini în Lut</p>
    </div>
  </body>
</html>
