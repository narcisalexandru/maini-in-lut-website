# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=maini_in_lut
# Local Postgres stays without TLS. Any other host requires certificate checks.
# DATABASE_SSL=true
# The application role should be allowed to read and write rows, not to CREATE or ALTER.
# Apply schema migrations with a separate owner role.

# App
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me
# Session cookie. Leave unset: same host uses SameSite=Lax, a different host uses None + Secure.
# Override only if the automatic choice is wrong:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# NODE_ENV=production turns off TypeORM synchronize and runs migrations.

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# Netopia Payments (sandbox)
# Cont sandbox: https://admin.netopia-payments.com (mod Sandbox activ)
#
# 1) NETOPIA_API_KEY = Profil > Securitate > genereaza cheie API (NU cheia privata!)
# 2) NETOPIA_POS_SIGNATURE = Punct de vanzare > Setari tehnice > Signature
# 3) NETOPIA_PUBLIC_KEY_PATH = certificatul PUBLIC (.cer) descarcat de la acelasi POS
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
NETOPIA_IS_LIVE=false
NETOPIA_PUBLIC_KEY_PATH=./certs/netopia-sandbox.cer

# Sameday Easybox locker map (public plugin credentials from the Sameday account)
SAMEDAY_LOCKER_CLIENT_ID=
SAMEDAY_API_USERNAME=
