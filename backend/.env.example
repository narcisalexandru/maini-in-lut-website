#
# 1) NETOPIA_API_KEY = Profil > Securitate > genereaza cheie API (NU cheia privata!)
# 2) NETOPIA_POS_SIGNATURE = Punct de vanzare > Setari tehnice > Signature
# 3) NETOPIA_PUBLIC_KEY_PATH = certificatul PUBLIC (.cer) descarcat de la acelasi POS
